# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PAYLOAD_SECRET=

# Dedicated Supabase Postgres project. Use a pooled connection at runtime and
# the direct connection only for migrations and administrative operations.
DATABASE_URI=
DATABASE_DIRECT_URI=
PAYLOAD_DATABASE_SCHEMA=cms

# Supabase Storage S3 compatibility. These credentials are server-only and
# provide broad bucket access.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email
RESEND_API_KEY=
DEFAULT_EMAIL_FROM_ADDRESS=
DEFAULT_EMAIL_FROM_NAME=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Protected background job runner
CRON_SECRET=
